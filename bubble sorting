 #include<stdio.h>
 int main(){
    int a[100],i,j,item,n;
    printf("Enter the no of  elements of the array:");
    scanf("%d",&n);
    printf("Enter the elements of the array:");
    for(i=0;i<n-1;i++){
        scanf("%d",&a[i]);
    }
    for(i=0;i<n-1;i++){
        for(j=0;j<n-1;j++){
            if(a[i]>a[i+1]){
                item=a[i];
                a[i]=a[i+1];
                a[i+1]=item;


            }
        }
    }
    printf("Sorted Array\n");
    for("i=0;i<n-1;i++"){
        printf("%d",&a[i]);
    }
 }
