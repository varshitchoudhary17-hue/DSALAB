// Online C compiler to run C program online
#include <stdio.h>

int main() {
    int arr[100],n,i,item,pos;
    printf("enter the number of elements:" );
    scanf("%d", &n);
    printf("enter the array elements:\n");
    for(i=0;i<n;i++){
        scanf("%d", &arr[i]);
}
        printf("enter the position (1 to %d): ",n + 1);
        scanf("%d",&pos);
    
    for(i =n;i>=pos;i--){
        arr[i] = arr[i-1];
    }
    arr[pos -1] = item;
    n++;
    printf("array after insertion:\n");
    for(i = 0;i<n;i++){
        printf("%d", arr[i]);
    }


    return 0;
}
